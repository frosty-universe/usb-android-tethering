# Copy to .env for local use. .env is gitignored; nothing here is read at runtime yet.
# Set a log file for a foreground run (same as --log-file):
#   UAT_LOG_FILE=/tmp/usb-android-tethering.log
UAT_LOG_FILE=
# Install a specific release with install.sh instead of the latest:
#   UAT_VERSION=v0.1.0
UAT_VERSION=
